+@Composable
+private fun GpuRangeGroup(
+    minControl: AxKernelControl,
+    maxControl: AxKernelControl,
+    kernelManager: AxKernelManager,
+    onKernelControlsChanged: () -> Unit,
+) {
+    // TYPE_GPU_MIN_FREQ/MAX_FREQ here are backed by the AxionOS gpuppm range
+    // limiter (LIMIT_AXION_USER), not the old devfreq min_freq/max_freq pair
+    // (decorative on this chip's non-GPUEB driver) or the single-value lock
+    // this replaces: the kernel clamps the automatic DVFS decision inside
+    // [min, max] instead of pinning one frequency, so the GPU still idles
+    // down normally. availableValues/valueLabels use the same OPP-index-
+    // mirrored convention as the single lock this replaces (see
+    // AxKernelConfigLoader.addGpuRangeIfPresent).
+    val indices = minControl.availableValues.toList()
+    val labels = minControl.valueLabels.toList().takeIf { it.size == indices.size }
+    PreferenceGroup(title = stringResource(R.string.gpu)) {
+        item {
+            KernelFrequencyPreference(
+                settingKey = minControl.id,
+                label = stringResource(R.string.minimum_frequency),
+                availableFreqs = indices,
+                maxFreq = indices.maxOrNull() ?: minControl.defaultValue,
+                defaultValue = minControl.defaultValue,
+                onCommit = { setKernelControl(kernelManager, minControl, it, onKernelControlsChanged) },
+                valueLabels = labels,
+            )
+        }
+        item {
+            KernelFrequencyPreference(
+                settingKey = maxControl.id,
+                label = stringResource(R.string.maximum_frequency),
+                availableFreqs = indices,
+                maxFreq = indices.maxOrNull() ?: maxControl.defaultValue,
+                defaultValue = maxControl.defaultValue,
+                onCommit = { setKernelControl(kernelManager, maxControl, it, onKernelControlsChanged) },
+                valueLabels = labels,
+            )
+        }
+        item {
+            Text(
+                text = stringResource(R.string.gpu_range_warning),
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp),
+            )
+        }
+    }
+}
+
