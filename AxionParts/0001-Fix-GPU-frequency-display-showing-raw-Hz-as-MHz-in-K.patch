From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: vigaz <pudimdebacon3@gmail.com>
Date: Sat, 19 Sep 2026 00:11:59 +0000
Subject: [PATCH 1/4] Fix GPU frequency display showing raw Hz as MHz in Kernel
 Manager

FrequencySlider hardcoded a /1000 divisor assuming all incoming raw
frequency values are in kHz (correct for CPU cpufreq). GPU devfreq
nodes (min_freq/max_freq/available_frequencies) report raw Hz instead,
so the GPU group displayed values 1000x too large (e.g. 315000 MHz
instead of 315 MHz). Added a configurable unitDivisor parameter,
defaulting to 1000 for existing CPU call sites, and pass 1_000_000 for
the GPU group.

Change-Id: I499378950dcb29ffdd4a8a2ed496e3e2cec65d3f
---
 .../axionparts/ui/components/PerformanceComponents.kt | 11 ++++++-----
 .../axionparts/ui/screens/KernelManagerScreen.kt      |  7 +++++++
 2 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/src/com/android/axion/axionparts/ui/components/PerformanceComponents.kt b/src/com/android/axion/axionparts/ui/components/PerformanceComponents.kt
index 6cde3d8..91f731e 100644
--- a/src/com/android/axion/axionparts/ui/components/PerformanceComponents.kt
+++ b/src/com/android/axion/axionparts/ui/components/PerformanceComponents.kt
@@ -55,6 +55,7 @@ fun FrequencySlider(
     accentColor: Color = MaterialTheme.colorScheme.primary,
     modifier: Modifier = Modifier,
     enabled: Boolean = true,
+    unitDivisor: Int = 1000,
 ) {
     val secureFlow = rememberSettingsFlow(SettingsType.SECURE)
     val persistedValue by rememberSettingInt(settingKey, SettingsType.SECURE, defaultValue)
@@ -81,7 +82,7 @@ fun FrequencySlider(
                 color = MaterialTheme.colorScheme.onSurface,
             )
             Text(
-                text = stringResource(R.string.mhz_format, currentValue.roundToInt() / 1000),
+                text = stringResource(R.string.mhz_format, currentValue.roundToInt() / unitDivisor),
                 style = MaterialTheme.typography.labelLarge,
                 color = accentColor,
             )
@@ -144,15 +145,15 @@ fun FrequencySlider(
         Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
             val minDisplay =
                 if (availableFrequencies != null && availableFrequencies.isNotEmpty()) {
-                    availableFrequencies.minOrNull()?.div(1000) ?: 0
+                    availableFrequencies.minOrNull()?.div(unitDivisor) ?: 0
                 } else {
-                    min / 1000
+                    min / unitDivisor
                 }
             val maxDisplay =
                 if (availableFrequencies != null && availableFrequencies.isNotEmpty()) {
-                    availableFrequencies.maxOrNull()?.div(1000) ?: 0
+                    availableFrequencies.maxOrNull()?.div(unitDivisor) ?: 0
                 } else {
-                    max / 1000
+                    max / unitDivisor
                 }
 
             Text(
diff --git a/src/com/android/axion/axionparts/ui/screens/KernelManagerScreen.kt b/src/com/android/axion/axionparts/ui/screens/KernelManagerScreen.kt
index 4b26b58..3e19d3e 100644
--- a/src/com/android/axion/axionparts/ui/screens/KernelManagerScreen.kt
+++ b/src/com/android/axion/axionparts/ui/screens/KernelManagerScreen.kt
@@ -257,6 +257,7 @@ private fun KernelFrequencyPreference(
     maxFreq: Int,
     defaultValue: Int,
     onCommit: ((Int) -> Unit)?,
+    unitDivisor: Int = 1000,
 ) {
     val secureFlow = rememberSettingsFlow(SettingsType.SECURE)
     val persistedValue by rememberSettingInt(settingKey, SettingsType.SECURE, defaultValue)
@@ -281,6 +282,7 @@ private fun KernelFrequencyPreference(
                 secureFlow.putInt(settingKey, selectedValue)
                 onCommit?.invoke(selectedValue)
             },
+            unitDivisor = unitDivisor,
         )
     }
 }
@@ -388,6 +390,9 @@ private fun GpuGroup(
     val availableFreqs = minControl.availableValues.toList()
     val maxFreq = availableFreqs.maxOrNull() ?: maxControl.defaultValue
 
+    // GPU devfreq nodes report raw Hz (min_freq/max_freq/available_frequencies), unlike CPU
+    // cpufreq's kHz convention, so this group needs its own divisor for MHz display.
+    val gpuUnitDivisor = 1_000_000
     PreferenceGroup(title = stringResource(R.string.gpu)) {
         item {
             KernelFrequencyPreference(
@@ -397,6 +402,7 @@ private fun GpuGroup(
                 maxFreq = maxFreq,
                 defaultValue = minControl.defaultValue,
                 onCommit = { setKernelControl(kernelManager, minControl, it, onKernelControlsChanged) },
+                unitDivisor = gpuUnitDivisor,
             )
         }
         item {
@@ -407,6 +413,7 @@ private fun GpuGroup(
                 maxFreq = maxFreq,
                 defaultValue = maxControl.defaultValue,
                 onCommit = { setKernelControl(kernelManager, maxControl, it, onKernelControlsChanged) },
+                unitDivisor = gpuUnitDivisor,
             )
         }
     }
