+    /**
+     * gpufreqv2 legacy DVFS (e.g. mt6768): pins an exact OPP index via a
+     * debug proc node, bypassing the devfreq governor layer that's a no-op
+     * on chips without GPUEB. availableValues are the working table's real
+     * frequencies (kHz) so the UI can show them directly; writeValues are
+     * the matching OPP index strings the node actually expects.
+     */
+    private static boolean addGpuOppIndexIfPresent(String group, List<KernelControlNode> controls) {
+        File fixIndexFile = new File(DIR_GPUFREQV2, NODE_GPUFREQV2_FIX_INDEX);
+        File tableFile = new File(DIR_GPUFREQV2, NODE_GPUFREQV2_WORKING_TABLE);
+        if (!fixIndexFile.isFile() || !tableFile.isFile()) return false;
+
+        int[] freqsKhz = readOppTableFrequenciesKhz(tableFile.getAbsolutePath());
+        if (freqsKhz.length == 0) return false;
+
+        int[] indices = indexedValues(freqsKhz.length);
+        String[] labels = AxKernelUtils.formatFrequencyLabels(freqsKhz);
+        String[] writeValues = indexStrings(indices.length);
+
+        int currentIndex = AxKernelUtils.readSysfsInt(fixIndexFile.getAbsolutePath(), -1);
+        int defaultIndex = (currentIndex >= 0 && currentIndex < indices.length)
+                ? currentIndex : indices[indices.length - 1];
+
+        controls.add(new KernelControlNode(ID_GPU_OPP_INDEX, group, AxKernelControl.TYPE_GPU_OPP_INDEX,
+                fixIndexFile.getAbsolutePath(), defaultIndex, indices, labels, writeValues));
+        return true;
+    }
+
+    private static int[] readOppTableFrequenciesKhz(String path) {
+        String text = AxKernelUtils.readSysfsString(path);
+        if (TextUtils.isEmpty(text)) return new int[0];
+        Matcher matcher = PATTERN_OPP_TABLE_FREQ.matcher(text);
+        ArrayList<Integer> freqs = new ArrayList<>();
+        while (matcher.find()) {
+            freqs.add(Integer.parseInt(matcher.group(1)));
+        }
+        int[] result = new int[freqs.size()];
+        for (int i = 0; i < result.length; i++) result[i] = freqs.get(i);
+        return result;
+    }
+
+    private static String[] indexStrings(int length) {
+        String[] result = new String[length];
+        for (int i = 0; i < length; i++) result[i] = String.valueOf(i);
+        return result;
+    }
+
