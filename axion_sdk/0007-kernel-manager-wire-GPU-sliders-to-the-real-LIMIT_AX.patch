+    private static boolean isGpuRangeControl(KernelControlNode control) {
+        return control != null && PATH_AXION_GPU_RANGE.equals(control.path);
+    }
+
+    /**
+     * The axion_gpu_range kernel node takes one combined write ("ceiling
+     * floor"), not one value per path like every other control. Look up the
+     * sibling control sharing this same path (the min control when writing
+     * max, or vice versa), read its last persisted value, and write both
+     * together. Both controls share the same index<->OPP mapping, so either
+     * one's toFileValue() converts correctly regardless of which slider
+     * moved.
+     */
+    private void writeGpuRange(KernelControlNode control, int value) {
+        KernelControlNode sibling = findGpuRangeSibling(control);
+        int siblingValue = readPersistedValue(sibling);
+        int maxUiValue = control.type == AxKernelControl.TYPE_GPU_MAX_FREQ ? value : siblingValue;
+        int minUiValue = control.type == AxKernelControl.TYPE_GPU_MIN_FREQ ? value : siblingValue;
+        String ceilingIdx = control.toFileValue(maxUiValue);
+        String floorIdx = control.toFileValue(minUiValue);
+        try {
+            FileUtils.stringToFile(control.path, ceilingIdx + " " + floorIdx);
+        } catch (IOException e) {
+            Slog.w(TAG, "Failed to write GPU range to " + control.path, e);
+        }
+    }
+
+    private KernelControlNode findGpuRangeSibling(KernelControlNode control) {
+        synchronized (mLock) {
+            for (KernelControlNode candidate : mControls.values()) {
+                if (candidate != control && isGpuRangeControl(candidate) && candidate.type != control.type) {
+                    return candidate;
+                }
+            }
+        }
+        return null;
+    }
+
+    private int readPersistedValue(KernelControlNode control) {
+        if (control == null) return 0;
+        int saved = Settings.Secure.getIntForUser(mResolver, control.id, Integer.MIN_VALUE, UserHandle.USER_CURRENT);
+        return saved != Integer.MIN_VALUE ? control.coerce(saved) : control.defaultValue;
+    }
+
