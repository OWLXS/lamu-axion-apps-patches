+    /**
+     * gpufreqv2 legacy DVFS (e.g. mt6768) with the AxionOS LIMIT_AXION_USER
+     * gpuppm limiter: the kernel clamps the automatic DVFS decision inside
+     * [ceiling, floor] instead of pinning one frequency, so this supersedes
+     * both the single-value OPP lock and the devfreq min_freq/max_freq pair
+     * (decorative on this chip's non-GPUEB driver -- see
+     * kernellamu-gpu-governor-kernel-manager memory). Same index mirroring
+     * and label convention as addGpuOppIndexIfPresent() below.
+     */
+    private static boolean addGpuRangeIfPresent(String group, List<KernelControlNode> controls) {
+        File rangeFile = new File(DIR_GPUFREQV2, NODE_GPUFREQV2_AXION_RANGE);
+        File tableFile = new File(DIR_GPUFREQV2, NODE_GPUFREQV2_WORKING_TABLE);
+        if (!rangeFile.isFile() || !tableFile.isFile()) {
+            return false;
+        }
+
+        int[] freqsKhz = readOppTableFrequenciesKhz(tableFile.getAbsolutePath());
+        if (freqsKhz.length == 0) {
+            return false;
+        }
+
+        int last = freqsKhz.length - 1;
+        int[] indices = new int[freqsKhz.length];
+        for (int i = 0; i <= last; i++) indices[i] = last - i;
+        String[] labels = AxKernelUtils.formatFrequencyLabels(freqsKhz);
+        String[] writeValues = indexStrings(indices.length);
+
+        // A fresh axion_gpu_range starts disabled (no prior user choice), so
+        // there is nothing meaningful to read back -- default to the full,
+        // unrestricted range (slowest..fastest), same as every other
+        // min/max pair on this screen. indices[] is mirrored (see above),
+        // so position 0 is the fastest raw OPP entry / highest UI value
+        // and the last position is the slowest / lowest UI value.
+        int defMin = indices[indices.length - 1];
+        int defMax = indices[0];
+
+        controls.add(new KernelControlNode(ID_GPU_MIN_FREQ, group, AxKernelControl.TYPE_GPU_MIN_FREQ,
+                rangeFile.getAbsolutePath(), defMin, indices, labels, writeValues));
+        controls.add(new KernelControlNode(ID_GPU_MAX_FREQ, group, AxKernelControl.TYPE_GPU_MAX_FREQ,
+                rangeFile.getAbsolutePath(), defMax, indices, labels, writeValues));
+        return true;
+    }
+
