+    /**
+     * GPU devfreq exposes the same governor/available_governors pair cpufreq does, so the
+     * control is built exactly like the CPU one: the value is an index into the available
+     * list and the label strings double as the values written back to sysfs.
+     */
+    private static void addGpuGovernorIfPresent(String govPath, String govAvailPath, String group,
+            List<KernelControlNode> controls) {
+        if (!canUse(govPath)) return;
+        String[] govs = AxKernelUtils.readSysfsTokens(govAvailPath);
+        if (govs.length == 0) return;
+        int defGov = stringIndex(govs, AxKernelUtils.readSysfsString(govPath), DEFAULT_GOV_INDEX);
+        controls.add(new KernelControlNode(ID_GPU_GOVERNOR, group, AxKernelControl.TYPE_GPU_GOVERNOR,
+                govPath, defGov, indexedValues(govs.length), govs, govs));
+    }
